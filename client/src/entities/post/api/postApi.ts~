import type { Post } from '../model/postTypes';

interface FeedParams {
  type?: 'public' | 'premium';
  page?: number;
  limit?: number;
}

interface FeedResponse {
  posts: Post[];
  page: number;
  totalPages: number;
}

type MockReaction = 'like' | 'dislike' | null;

type NotificationType =
    | 'REQUEST_APPROVED'
    | 'REQUEST_REJECTED'
    | 'NEW_LIKE'
    | 'NEW_COMMENT';

interface MockPostInteraction {
  reaction: MockReaction;
  saved: boolean;
}

type MockPostInteractions = Record<string, Record<string, MockPostInteraction>>;

interface MockUser {
  id: number;
  nickname: string;
  email: string;
  avatarUrl?: string | null;
  role: 'USER' | 'ADMIN';
  hasPremium: boolean;
}

interface MockNotification {
  id: number;
  userId: number;
  type: NotificationType;
  title: string;
  text: string;
  isRead: boolean;
  postId?: number | null;
  requestId?: number | null;
  createdAt: string;
}

