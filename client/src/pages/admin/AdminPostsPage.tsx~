} from 'react-icons/fi';

import type {
    MediaType,
    Post,
    PostVisibility,
} from '../../entities/post/model/postTypes';

type VisibilityFilter = 'ALL' | PostVisibility;
type MediaFilter = 'ALL' | MediaType;

type MockPostInteractions = Record<
    string,
    Record<
        string,
        {
            reaction: 'like' | 'dislike' | null;
            saved: boolean;
        }
    >
>;

const MOCK_POSTS_KEY = 'pulsefeed_mock_posts';
const MOCK_POST_INTERACTIONS_KEY = 'pulsefeed_mock_post_interactions';

export function AdminPostsPage() {
    const [posts, setPosts] = useState<Post[]>([]);
    const [visibilityFilter, setVisibilityFilter] =
        useState<VisibilityFilter>('ALL');
    const [mediaFilter, setMediaFilter] = useState<MediaFilter>('ALL');
    const [search, setSearch] = useState('');

    const loadPosts = () => {
        setPosts(getSavedPosts());
    };

    useEffect(() => {
        loadPosts();
    }, []);

    const stats = useMemo(() => {
        const publicCount = posts.filter(
            (post) => post.visibility === 'PUBLIC'
        ).length;

        const premiumCount = posts.filter(
            (post) => post.visibility === 'PREMIUM'
        ).length;

        const imageCount = posts.filter(
            (post) => post.media[0]?.type === 'IMAGE'
        ).length;

        const videoCount = posts.filter(
            (post) => post.media[0]?.type === 'VIDEO'
        ).length;

        return {
            publicCount,
            premiumCount,
            imageCount,
            videoCount,
        };
    }, [posts]);

    const filteredPosts = useMemo(() => {
        const normalizedSearch = search.trim().toLowerCase();

        return posts
            .filter((post) => {
                if (visibilityFilter !== 'ALL' && post.visibility !== visibilityFilter) {
                    return false;
                }

                if (mediaFilter !== 'ALL' && post.media[0]?.type !== mediaFilter) {
                    return false;
                }

                if (!normalizedSearch) {
                    return true;
                }

                const title = post.title?.toLowerCase() || '';
                const description = post.description?.toLowerCase() || '';
                const author = post.author.nickname.toLowerCase();

                return (
                    title.includes(normalizedSearch) ||
                    description.includes(normalizedSearch) ||
                    author.includes(normalizedSearch)
                );
            })
            .sort(
                (a, b) =>
                    new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
            );
    }, [mediaFilter, posts, search, visibilityFilter]);

    const updatePosts = (nextPosts: Post[]) => {
        setPosts(nextPosts);
        localStorage.setItem(MOCK_POSTS_KEY, JSON.stringify(nextPosts));
    };

    const handleDeletePost = (postId: number) => {
        const post = posts.find((item) => item.id === postId);

        if (!post) {
            return;
        }

        const isConfirmed = window.confirm(
            `Удалить пост «${post.title || 'Без названия'}»? Это действие нельзя отменить.`
        );

        if (!isConfirmed) {
            return;
        }

        const nextPosts = posts.filter((item) => item.id !== postId);

        updatePosts(nextPosts);
        removePostInteractions(postId);
    };

    const resetFilters = () => {
        setVisibilityFilter('ALL');
        setMediaFilter('ALL');
        setSearch('');
    };

    return (
        <Page>
            <Hero>
                <HeroContent>
                    <Eyebrow>Admin</Eyebrow>
                    <Title>Управление постами</Title>
                    <Subtitle>
                        Здесь админ видит все опубликованные материалы: обычные и Premium
                        посты, фото и видео. Пока данные хранятся во фронтовом localStorage.
                    </Subtitle>
                </HeroContent>

                <RefreshButton type="button" onClick={loadPosts}>
                    <FiRefreshCw />
                    Обновить
                </RefreshButton>
            </Hero>

            <StatsGrid>
                <StatCard>
                    <StatIcon $variant="blue">
                        <FiGlobe />
                    </StatIcon>

                    <StatInfo>
                        <strong>{stats.publicCount}</strong>
                        <span>Обычных постов</span>
                    </StatInfo>
                </StatCard>

                <StatCard>
                    <StatIcon $variant="pink">
                        <FiStar />
                    </StatIcon>

                    <StatInfo>
                        <strong>{stats.premiumCount}</strong>
                        <span>Premium постов</span>
                    </StatInfo>
                </StatCard>

                <StatCard>
                    <StatIcon $variant="purple">
                        <FiImage />
                    </StatIcon>

                    <StatInfo>
                        <strong>{stats.imageCount}</strong>
                        <span>Фото</span>
                    </StatInfo>
                </StatCard>

                <StatCard>
                    <StatIcon $variant="red">
                        <FiVideo />
                    </StatIcon>

                    <StatInfo>
                        <strong>{stats.videoCount}</strong>
                        <span>Видео</span>
                    </StatInfo>
                </StatCard>
            </StatsGrid>

            <Toolbar>
                <SearchBox>
                    <FiSearch />
                    <input
                        type="text"
                        placeholder="Поиск по названию, описанию или автору"
                        value={search}
                        onChange={(event) => setSearch(event.target.value)}
                    />
                </SearchBox>

                <Filters>
                    <FilterSelect
                        value={visibilityFilter}
                        onChange={(event) =>
                            setVisibilityFilter(event.target.value as VisibilityFilter)
                        }
                    >
                        <option value="ALL">Все ленты</option>
                        <option value="PUBLIC">Обычная лента</option>
                        <option value="PREMIUM">Premium</option>
                    </FilterSelect>

                    <FilterSelect
                        value={mediaFilter}
                        onChange={(event) =>
                            setMediaFilter(event.target.value as MediaFilter)
                        }
                    >
                        <option value="ALL">Все типы</option>
                        <option value="IMAGE">Фото</option>
                        <option value="VIDEO">Видео</option>
                    </FilterSelect>

                    <ResetButton type="button" onClick={resetFilters}>
                        <FiFilter />
                        Сбросить
                    </ResetButton>
                </Filters>
            </Toolbar>

            {filteredPosts.length ? (
                <PostsGrid>
                    {filteredPosts.map((post) => {
                        const firstMedia = post.media[0];

                        return (
                            <PostCard key={post.id}>
                                <Preview>
                                    {firstMedia?.type === 'IMAGE' ? (
                                        <img src={firstMedia.url} alt={post.title || 'Пост'} />
                                    ) : firstMedia?.type === 'VIDEO' ? (
                                        <VideoPreview>
                                            <video src={firstMedia.url} muted />
                                            <VideoOverlay>
                                                <FiVideo />
                                                Видео
                                            </VideoOverlay>
                                        </VideoPreview>
                                    ) : (
                                        <Placeholder>
                                            <FiFileText />
                                            <span>Нет медиа</span>
                                        </Placeholder>
                                    )}

                                    <VisibilityBadge $visibility={post.visibility}>
                                        {post.visibility === 'PREMIUM' ? (
                                            <>
                                                <FiStar />
                                                Premium
                                            </>
                                        ) : (
                                            <>
                                                <FiGlobe />
                                                Public
                                            </>
                                        )}
                                    </VisibilityBadge>
                                </Preview>

                                <CardBody>
                                    <CardHeader>
                                        <div>
                                            <PostTitle>{post.title || 'Без названия'}</PostTitle>
                                            <Meta>
                                                @{post.author.nickname} •{' '}
                                                {new Date(post.createdAt).toLocaleString('ru-RU')}
                                            </Meta>
                                        </div>

                                        <MediaBadge>
                                            {firstMedia?.type === 'VIDEO' ? <FiVideo /> : <FiImage />}
                                            {firstMedia?.type === 'VIDEO' ? 'Видео' : 'Фото'}
                                        </MediaBadge>
                                    </CardHeader>

                                    <Description>
                                        {post.description || 'Описание не добавлено.'}
                                    </Description>

                                    <Metrics>
                                        <Metric>
                                            <FiHeart />
                                            <span>{post.likesCount}</span>
                                        </Metric>

                                        <Metric>
                                            <FiThumbsDown />
                                            <span>{post.dislikesCount}</span>
                                        </Metric>

                                        <Metric>
                                            <FiMessageCircle />
                                            <span>{post.commentsCount}</span>
                                        </Metric>

                                        <Metric>
                                            <FiBookmark />
                                            <span>{post.isSavedByMe ? 'Сохранен' : '—'}</span>
                                        </Metric>
                                    </Metrics>

                                    <InfoList>
                                        <InfoItem>
                                            <strong>ID:</strong>
                                            <span>{post.id}</span>
                                        </InfoItem>

                                        <InfoItem>
                                            <strong>Лента:</strong>
                                            <span>
                        {post.visibility === 'PREMIUM'
                            ? 'Premium'
                            : 'Обычная'}
                      </span>
                                        </InfoItem>

                                        <InfoItem>
                                            <strong>Дата:</strong>
                                            <span>
                        <FiCalendar />
                                                {new Date(post.createdAt).toLocaleDateString('ru-RU')}
                      </span>
                                        </InfoItem>
                                    </InfoList>

                                    <Actions>
                                        <DeleteButton
                                            type="button"
                                            onClick={() => handleDeletePost(post.id)}
                                        >
                                            <FiTrash2 />
                                            Удалить пост
                                        </DeleteButton>
                                    </Actions>
                                </CardBody>
                            </PostCard>
                        );
                    })}
                </PostsGrid>
            ) : (
                <EmptyCard>
                    <FiAlertCircle />
                    <h2>Посты не найдены</h2>
                    <p>
                        Попробуйте сбросить фильтры, создать новый пост или принять заявку
                        пользователя в админке.
                    </p>

                    <EmptyButton type="button" onClick={resetFilters}>
                        Сбросить фильтры
                    </EmptyButton>
                </EmptyCard>
            )}
        </Page>
    );
}

function getSavedPosts(): Post[] {
    const savedPosts = localStorage.getItem(MOCK_POSTS_KEY);

    if (!savedPosts) {
        return [];
    }

    try {
        return JSON.parse(savedPosts) as Post[];
    } catch {
        localStorage.removeItem(MOCK_POSTS_KEY);
        return [];
    }
}

function removePostInteractions(postId: number) {
    const savedInteractions = localStorage.getItem(MOCK_POST_INTERACTIONS_KEY);

    if (!savedInteractions) {
        return;
    }

    try {
        const interactions = JSON.parse(savedInteractions) as MockPostInteractions;

        const nextInteractions = Object.fromEntries(
            Object.entries(interactions).map(([userId, userInteractions]) => {
                const nextUserInteractions = { ...userInteractions };

                delete nextUserInteractions[String(postId)];

                return [userId, nextUserInteractions];
            })
        );

        localStorage.setItem(
            MOCK_POST_INTERACTIONS_KEY,
            JSON.stringify(nextInteractions)
        );
    } catch {
        localStorage.removeItem(MOCK_POST_INTERACTIONS_KEY);
    }
}

