import { Link } from 'react-router-dom';
import styled from 'styled-components';
import { FiBookmark, FiRefreshCw, FiSearch } from 'react-icons/fi';

import { useGetSavedPostsQuery } from '../entities/post/api/postApi';
import { PostGrid } from '../entities/post/ui/PostGrid';

export function SavedPostsPage() {
    const {
        data,
        isLoading,
        isFetching,
        isError,
        refetch,
    } = useGetSavedPostsQuery({
        page: 1,
        limit: 20,
    });

    const posts = data?.posts || [];

    if (isLoading) {
        return (
            <StateCard>
                <FiBookmark />
                <h1>Загружаем сохраненные посты</h1>
                <p>Сейчас покажем публикации, которые вы добавили в свой профиль.</p>
            </StateCard>
        );
    }

    if (isError) {
        return (
            <StateCard>
                <FiRefreshCw />
                <h1>Не удалось загрузить сохраненные посты</h1>
                <p>
                    Проверьте подключение или попробуйте обновить список сохраненных
                    публикаций.
                </p>

                <PrimaryButton type="button" onClick={() => refetch()}>
                    <FiRefreshCw />
                    Повторить
                </PrimaryButton>
            </StateCard>
        );
    }

    return (
        <Page>
            <Hero>
                <HeroContent>
                    <Eyebrow>Личный раздел</Eyebrow>
                    <Title>Сохраненные посты</Title>
                    <Subtitle>
                        Здесь находятся публикации, которые вы сохранили в свой профиль.
                        Другие пользователи не видят ваши сохранения.
                    </Subtitle>
                </HeroContent>

                <HeroBadge>
                    <FiBookmark />
                    {posts.length}
                </HeroBadge>
            </Hero>

            {posts.length ? (
                <>
                    <Toolbar>
                        <SearchBox>
                            <FiSearch />
                            <input
                                type="text"
                                placeholder="Поиск по сохраненным постам появится позже"
                                disabled
                            />
                        </SearchBox>

                        <RefreshButton
                            type="button"
                            disabled={isFetching}
                            onClick={() => refetch()}
                        >
                            <FiRefreshCw />
                            {isFetching ? 'Обновляем...' : 'Обновить'}
                        </RefreshButton>
                    </Toolbar>

                    <PostGrid posts={posts} />
                </>
            ) : (
                <EmptyCard>
                    <IconCircle>
                        <FiBookmark />
                    </IconCircle>

                    <h2>Пока нет сохраненных постов</h2>

                    <p>
                        Нажимайте кнопку «Сохранить» под интересными публикациями, и они
                        будут появляться здесь.
                    </p>

                    <PrimaryLink to="/">Перейти в ленту</PrimaryLink>
                </EmptyCard>
            )}
        </Page>
    );
}

