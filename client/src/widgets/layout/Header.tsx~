import { Link } from 'react-router-dom';
import { useDispatch, useSelector } from 'react-redux';
import styled from 'styled-components';
import { FiLogIn, FiSearch, FiUser } from 'react-icons/fi';

import type { AppDispatch, RootState } from '../../app/store';
import { openAuthModal } from '../../entities/auth/slice/authSlice';

export function Header() {
    const dispatch = useDispatch<AppDispatch>();

    const { accessToken, user } = useSelector((state: RootState) => state.auth);

    const isAuth = Boolean(accessToken);

    const handleOpenLogin = () => {
        dispatch(
            openAuthModal({
                mode: 'login',
                reason:
                    'Войдите в аккаунт, чтобы лайкать, комментировать, сохранять посты и открывать личные разделы.',
            })
        );
    };

    return (
        <HeaderRoot>
            <HeaderInner>
                <Logo to="/">PulseFeed</Logo>

                <Actions>
                    <SearchButton aria-label="Поиск" type="button">
                        <FiSearch />
                    </SearchButton>

                    {isAuth ? (
                        <ProfileLink to="/profile">
                            <ProfileAvatar>
                                {user?.avatarUrl ? (
                                    <img src={user.avatarUrl} alt={user.nickname} />
                                ) : (
                                    <FiUser />
                                )}
                            </ProfileAvatar>

                            <ProfileText>
                                <strong>{user?.nickname || 'Профиль'}</strong>
                                <span>{user?.hasPremium ? 'Premium' : 'Аккаунт'}</span>
                            </ProfileText>
                        </ProfileLink>
                    ) : (
                        <LoginButton type="button" onClick={handleOpenLogin}>
                            <FiLogIn />
                            <span>Войти</span>
                        </LoginButton>
                    )}
                </Actions>
            </HeaderInner>
        </HeaderRoot>
    );
}

const HeaderRoot = styled.header`
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid ${({ theme }) => theme.colors.border};
    background: rgba(8, 10, 18, 0.82);
    backdrop-filter: blur(18px);
`;

const HeaderInner = styled.div`
    width: min(1180px, 100%);
    height: 68px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
    gap: 24px;

    @media (max-width: ${({ theme }) => theme.breakpoints.tablet}) {
        height: 60px;
        padding: 0 12px;
        gap: 12px;
    }
`;

const Logo = styled(Link)`
    flex: 0 0 auto;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, #8b5cf6, #2563eb, #ef4444);
    -webkit-background-clip: text;
    color: transparent;
`;

const Actions = styled.div`
    min-width: 0;
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
`;

const SearchButton = styled.button`
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border: 1px solid ${({ theme }) => theme.colors.border};
    border-radius: ${({ theme }) => theme.radius.full};
    background: ${({ theme }) => theme.colors.bgSoft};
    color: ${({ theme }) => theme.colors.text};
    display: grid;
    place-items: center;
    font-size: 20px;

    &:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    @media (max-width: ${({ theme }) => theme.breakpoints.mobile}) {
        display: none;
    }
`;

const ProfileLink = styled(Link)`
    min-width: 0;
    max-width: 230px;
    height: 46px;
    padding: 4px 12px 4px 4px;
    border: 1px solid rgba(124, 58, 237, 0.24);
    border-radius: ${({ theme }) => theme.radius.full};
    background:
            linear-gradient(135deg, rgba(124, 58, 237, 0.22), rgba(37, 99, 235, 0.14)),
            rgba(255, 255, 255, 0.045);
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 800;

    &:hover {
        border-color: rgba(139, 92, 246, 0.56);
        background:
                linear-gradient(135deg, rgba(124, 58, 237, 0.32), rgba(37, 99, 235, 0.2)),
                rgba(255, 255, 255, 0.065);
    }

    @media (max-width: ${({ theme }) => theme.breakpoints.mobile}) {
        width: 44px;
        height: 44px;
        padding: 3px;
        justify-content: center;
    }
`;

const ProfileAvatar = styled.div`
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    overflow: hidden;
    border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #2563eb);
    color: white;
    display: grid;
    place-items: center;
    font-size: 18px;

    img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    @media (max-width: ${({ theme }) => theme.breakpoints.mobile}) {
        width: 38px;
        height: 38px;
    }
`;

const ProfileText = styled.span`
    min-width: 0;
    display: grid;
    gap: 1px;

    strong {
        overflow: hidden;
        max-width: 150px;
        color: ${({ theme }) => theme.colors.text};
        font-size: 13px;
        line-height: 1.1;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    span {
        color: ${({ theme }) => theme.colors.textMuted};
        font-size: 11px;
        line-height: 1.1;
        font-weight: 800;
    }

    @media (max-width: ${({ theme }) => theme.breakpoints.mobile}) {
        display: none;
    }
`;

const LoginButton = styled.button`
    height: 42px;
    padding: 0 15px;
    border: none;
    border-radius: ${({ theme }) => theme.radius.full};
    background: linear-gradient(135deg, #7c3aed, #2563eb);
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 900;

    &:hover {
        filter: brightness(1.08);
    }

    @media (max-width: ${({ theme }) => theme.breakpoints.mobile}) {
        width: 42px;
        padding: 0;
        justify-content: center;

        span {
            display: none;
        }
    }
`;