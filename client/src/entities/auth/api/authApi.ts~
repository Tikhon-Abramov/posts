import { baseApi } from '../../../shared/api/baseApi';
import type { AuthUser } from '../model/authTypes';

interface LoginDto {
  email: string;
  password: string;
}

interface RegisterDto {
  nickname: string;
  email: string;
  password: string;
}

interface UpdateProfileDto {
  nickname: string;
  email: string;
  avatarUrl?: string | null;
}

interface ChangePasswordDto {
  currentPassword: string;
  newPassword: string;
}

interface AuthResponse {
  user: AuthUser;
  accessToken: string;
}

interface MockUser extends AuthUser {
  password: string;
}

interface MockPostLike {
  author?: {
    id: number;
    nickname: string;
    avatarUrl?: string | null;
  };
}

interface MockCommentLike {
  author?: {
    id: number;
    nickname: string;
    avatarUrl?: string | null;
  };
}

interface MockContentRequestLike {
  userId: number;
  userNickname: string;
}

const USE_MOCK_AUTH = import.meta.env.VITE_USE_MOCK_AUTH !== 'false';

const MOCK_USERS_KEY = 'pulsefeed_mock_users';
const MOCK_POSTS_KEY = 'pulsefeed_mock_posts';
const MOCK_COMMENTS_KEY = 'pulsefeed_mock_comments';
const MOCK_CONTENT_REQUESTS_KEY = 'pulsefeed_mock_content_requests';

