import type { RootState } from '../../app/store';
import type {
  MediaType,
  Post,
  PostVisibility,
} from '../../entities/post/model/postTypes';

const MOCK_POSTS_KEY = 'pulsefeed_mock_posts';

const MAX_IMAGE_STORAGE_SIZE = 1200 * 1024;

export function AdminCreatePostPage() {
  const user = useSelector((state: RootState) => state.auth.user);

  const [title, setTitle] = useState('');
  const [description, setDescription] = useState('');
  const [visibility, setVisibility] = useState<PostVisibility>('PUBLIC');
  const [mediaType, setMediaType] = useState<MediaType>('IMAGE');
  const [file, setFile] = useState<File | null>(null);
  const [localPreviewUrl, setLocalPreviewUrl] = useState<string | null>(null);
  const [savedImageUrl, setSavedImageUrl] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [successPostId, setSuccessPostId] = useState<number | null>(null);

  const fileInputAccept = mediaType === 'IMAGE' ? 'image/*' : 'video/*';

  const isSubmitDisabled = useMemo(() => {
    return !title.trim() || !description.trim() || !file || !user;
  }, [description, file, title, user]);

  useEffect(() => {
    return () => {
      if (localPreviewUrl) {
        URL.revokeObjectURL(localPreviewUrl);
      }
    };
  }, [localPreviewUrl]);

  const resetPreview = () => {
    if (localPreviewUrl) {
      URL.revokeObjectURL(localPreviewUrl);
    }

    setLocalPreviewUrl(null);
    setSavedImageUrl(null);
  };

  const resetForm = () => {
    setTitle('');
    setDescription('');
    setVisibility('PUBLIC');
    setMediaType('IMAGE');
    setFile(null);
    resetPreview();
  };

  const handleMediaTypeChange = (nextMediaType: MediaType) => {
    setMediaType(nextMediaType);
    setFile(null);
    setError(null);
    setSuccessPostId(null);
    resetPreview();
  };

  const handleFileChange = (event: ChangeEvent<HTMLInputElement>) => {
    const selectedFile = event.target.files?.[0] || null;

    setError(null);
    setSuccessPostId(null);
    resetPreview();

    if (!selectedFile) {
      setFile(null);
      return;
    }

    const isImage = selectedFile.type.startsWith('image/');
    const isVideo = selectedFile.type.startsWith('video/');

    if (mediaType === 'IMAGE' && !isImage) {
      setError('Выберите файл изображения.');
      event.target.value = '';
      return;
    }

    if (mediaType === 'VIDEO' && !isVideo) {
      setError('Выберите видеофайл.');
      event.target.value = '';
      return;
    }

    setFile(selectedFile);
    setLocalPreviewUrl(URL.createObjectURL(selectedFile));

    if (isImage && selectedFile.size <= MAX_IMAGE_STORAGE_SIZE) {
      const reader = new FileReader();

      reader.onload = () => {
        setSavedImageUrl(String(reader.result));
      };

      reader.readAsDataURL(selectedFile);
    }
  };

  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();

    setError(null);
    setSuccessPostId(null);

    if (!user) {
      setError('Админ не найден. Войдите в админский аккаунт заново.');
      return;
    }

    if (!title.trim()) {
      setError('Введите название поста.');
      return;
    }

    if (!description.trim()) {
      setError('Добавьте описание поста.');
      return;
    }

    if (!file) {
      setError('Прикрепите фото или видео.');
      return;
    }

    const postId = Date.now();

    const newPost: Post = {
      id: postId,
      title: title.trim(),
      description: description.trim(),
      visibility,
      media: [
        {
          id: postId,
          type: mediaType,
          url:
              mediaType === 'IMAGE'
                  ? savedImageUrl || createMockImageUrl(title.trim())
                  : 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4',
        },
      ],
      author: {
        id: user.id,
        nickname: user.nickname,
        avatarUrl: user.avatarUrl,
      },
      likesCount: 0,
      dislikesCount: 0,
      commentsCount: 0,
      isLikedByMe: false,
      isDislikedByMe: false,
      isSavedByMe: false,
      createdAt: new Date().toISOString(),
    };

    const currentPosts = getSavedPosts();

    localStorage.setItem(MOCK_POSTS_KEY, JSON.stringify([newPost, ...currentPosts]));

    resetForm();
    setSuccessPostId(postId);
  };

  return (
      <Page>
        <Hero>
          <HeroContent>
            <Eyebrow>Admin</Eyebrow>

            <Title>Создать пост</Title>

            <Subtitle>
              Ручная публикация фото или видео от имени администратора. Пост можно
              отправить в обычную ленту или в Premium.
            </Subtitle>
          </HeroContent>

          <BackLink to="/admin/posts">
            <FiArrowLeft />
            К постам
          </BackLink>
        </Hero>

        <Grid>
          <FormCard onSubmit={handleSubmit}>
            <SectionHeader>
              <div>
                <Eyebrow>Новая публикация</Eyebrow>
                <h2>Данные поста</h2>
              </div>

              <HeaderIcon>
                <FiPlusCircle />
              </HeaderIcon>
            </SectionHeader>

            {successPostId && (
                <SuccessBox>
                  <FiCheckCircle />
                  <span>
                Пост создан и сохранен в mock-ленту. ID поста: {successPostId}.
              </span>
                </SuccessBox>
            )}

            {error && (
                <ErrorBox>
                  <FiAlertCircle />
                  <span>{error}</span>
                </ErrorBox>
            )}

            <Field>
              <Label htmlFor="post-title">Название</Label>

              <Input
                  id="post-title"
                  type="text"
                  placeholder="Например, Закрытый backstage"
                  value={title}
                  maxLength={90}
                  onChange={(event) => {
                    setTitle(event.target.value);
                    setSuccessPostId(null);
                  }}
              />

              <Counter>{title.length}/90</Counter>
            </Field>

            <Field>
              <Label htmlFor="post-description">Описание</Label>

              <Textarea
                  id="post-description"
                  placeholder="Добавьте текст публикации"
                  value={description}
                  maxLength={800}
                  onChange={(event) => {
                    setDescription(event.target.value);
                    setSuccessPostId(null);
                  }}
              />

              <Counter>{description.length}/800</Counter>
            </Field>

            <OptionsGrid>
              <Field>
                <Label>Тип публикации</Label>

                <Segmented>
                  <SegmentButton
                      type="button"
                      $active={visibility === 'PUBLIC'}
                      onClick={() => setVisibility('PUBLIC')}
                  >
                    <FiGlobe />
                    Обычная
                  </SegmentButton>

                  <SegmentButton
                      type="button"
                      $active={visibility === 'PREMIUM'}
                      onClick={() => setVisibility('PREMIUM')}
                  >
                    <FiStar />
                    Premium
                  </SegmentButton>
                </Segmented>
              </Field>

              <Field>
                <Label>Тип файла</Label>

                <Segmented>
                  <SegmentButton
                      type="button"
                      $active={mediaType === 'IMAGE'}
                      onClick={() => handleMediaTypeChange('IMAGE')}
                  >
                    <FiImage />
                    Фото
                  </SegmentButton>

                  <SegmentButton
                      type="button"
                      $active={mediaType === 'VIDEO'}
                      onClick={() => handleMediaTypeChange('VIDEO')}
                  >
                    <FiVideo />
                    Видео
                  </SegmentButton>
                </Segmented>
              </Field>
            </OptionsGrid>

            <Field>
              <Label htmlFor="post-file">Медиафайл</Label>

              <UploadBox htmlFor="post-file">
                <UploadIcon>
                  <FiUploadCloud />
                </UploadIcon>

                <UploadText>
                  <strong>
                    {file ? file.name : 'Выберите фото или видео для публикации'}
                  </strong>

                  <span>
                  {mediaType === 'IMAGE'
                      ? 'Для временного mock-режима лучше использовать изображение до 1.2 MB.'
                      : 'В mock-режиме видео не сохраняется полностью, после создания будет использоваться тестовое видео.'}
                </span>
                </UploadText>

                <input
                    id="post-file"
                    type="file"
                    accept={fileInputAccept}
                    onChange={handleFileChange}
                />
              </UploadBox>
            </Field>

            {file && (
                <FileInfo>
                  <strong>Файл:</strong>
                  <span>{file.name}</span>
                  <small>{formatFileSize(file.size)}</small>
                </FileInfo>
            )}

            {localPreviewUrl && (
                <PreviewCard>
                  <PreviewHeader>
                    <strong>Предпросмотр</strong>

                    <span>
                  {visibility === 'PREMIUM'
                      ? 'Будет опубликовано в Premium'
                      : 'Будет опубликовано в обычной ленте'}
                </span>
                  </PreviewHeader>

                  {mediaType === 'IMAGE' ? (
                      <img src={localPreviewUrl} alt="Предпросмотр поста" />
                  ) : (
                      <video src={localPreviewUrl} controls />
                  )}
                </PreviewCard>
            )}

            <SubmitButton type="submit" disabled={isSubmitDisabled}>
              <FiSave />
              Опубликовать пост
            </SubmitButton>
          </FormCard>

          <InfoColumn>
            <InfoCard>
              <InfoIcon>
                <FiInfo />
              </InfoIcon>

              <h2>Как проверить</h2>

              <p>
                После создания пост сразу появится в mock-данных. Обычный пост
                будет виден на главной ленте, Premium — только в закрытой ленте
                у пользователя с подпиской.
              </p>

              <InfoLinks>
                <InfoLink to="/">
                  <FiGlobe />
                  Открыть обычную ленту
                </InfoLink>

                <InfoLink to="/premium">
                  <FiStar />
                  Открыть Premium
                </InfoLink>

                <InfoLink to="/admin/posts">
                  <FiFileText />
                  Управление постами
                </InfoLink>
              </InfoLinks>
            </InfoCard>

            <InfoCard>
              <InfoIcon>
                <FiAlertCircle />
              </InfoIcon>

              <h2>Ограничение mock-режима</h2>

              <p>
                Изображения можно временно сохранить в localStorage, если они не
                слишком большие. Видео в localStorage не сохраняем, поэтому для
                созданных видео-постов используется тестовый ролик.
              </p>
            </InfoCard>
          </InfoColumn>
        </Grid>
      </Page>
  );
}

function getSavedPosts(): Post[] {
  const savedPosts = localStorage.getItem(MOCK_POSTS_KEY);

  if (!savedPosts) {
    return [];
  }

  try {
    return JSON.parse(savedPosts) as Post[];
  } catch {
    localStorage.removeItem(MOCK_POSTS_KEY);
    return [];
  }
}

function createMockImageUrl(title: string) {
  const svg = `
    <svg width="1200" height="900" viewBox="0 0 1200 900" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="1200" height="900" fill="#080A12"/>
      <circle cx="230" cy="180" r="370" fill="#7c3aed" opacity="0.55"/>
      <circle cx="980" cy="720" r="430" fill="#2563eb" opacity="0.45"/>
      <circle cx="860" cy="200" r="240" fill="#ef4444" opacity="0.25"/>
      <rect x="90" y="90" width="1020" height="720" rx="52" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.18)" stroke-width="2"/>
      <text x="120" y="445" fill="white" font-family="Inter, Arial, sans-serif" font-size="70" font-weight="900" letter-spacing="-4">${escapeSvgText(title)}</text>
      <text x="124" y="510" fill="rgba(255,255,255,0.72)" font-family="Inter, Arial, sans-serif" font-size="30" font-weight="700">Admin created post</text>
    </svg>
  `;

  return `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;
}

function escapeSvgText(text: string) {
  return text
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
}

function formatFileSize(size: number) {
  if (size < 1024) {
    return `${size} B`;
  }

  if (size < 1024 * 1024) {
    return `${(size / 1024).toFixed(1)} KB`;
  }

  return `${(size / 1024 / 1024).toFixed(1)} MB`;
}

